[Unit]
Description=OBD-Cortex Edge Device Logger
Documentation=https://github.com/OBD-Cortex/Edge
After=network.target network-online.target CanMonitor.service
Wants=network-online.target
# Hard dependency: Edge logger cannot function without the CAN bus monitor.
# If CanMonitor.service stops, this unit stops too automatically.
Requires=CanMonitor.service

[Service]
# Change 'pi' to your actual Raspberry Pi username if different
User=obdpi
Group=obdpi
WorkingDirectory=/home/obdpi/Edge
Environment="PATH=/home/obdpi/Edge/venv/bin"

# The core daemon execution
ExecStart=/home/obdpi/Edge/venv/bin/python src/main.py

# Auto-restart if the script crashes (e.g. transient cloud outage)
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
