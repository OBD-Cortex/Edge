[Unit]
Description=OBD-Cortex Edge Device Logger
Documentation=https://github.com/OBD-Cortex/Edge
After=network.target network-online.target CanBus.service
Wants=network-online.target
# Hard dependency on the CAN bus interface being active.
# If CanBus.service stops, this unit stops automatically.
Requires=CanBus.service

[Service]
User=obdpi
Group=obdpi
WorkingDirectory=/home/obdpi/Edge
Environment="PATH=/home/obdpi/Edge/venv/bin"

# The core diagnostic and telemetry daemon
ExecStart=/home/obdpi/Edge/venv/bin/python src/main.py

# Auto-restart if the script crashes (e.g. transient cloud outage)
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
