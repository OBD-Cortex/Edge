[Unit]
Description=OBD-Cortex Data Logger
After=network.target

[Service]
# Let the OS inject the environment securely
EnvironmentFile=/home/obdpi/obd-cortex/.env

# CRITICAL: Point directly to the python binary inside your venv folder
ExecStart=/home/obdpi/obd-cortex/obd-venv/bin/python /home/obdpi/obd-cortex/src/main.py

# Set the working directory so it finds your .env files
WorkingDirectory=/home/obdpi/obd-cortex

# Restart automatically if it crashes
Restart=on-failure
RestartSec=10
User=obdpi

# Production logging & timeout configuration
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obd-cortex
TimeoutStartSec=30
TimeoutStopSec=30

# ----------------------------------------------------------
# SECURITY HARDENING DIRECTIVES
# ----------------------------------------------------------
# Prevent the service from escalating privileges
NoNewPrivileges=true

# Mount /usr, /boot, /efi as read-only
ProtectSystem=strict

# Restrict home directory access to read-only
ProtectHome=read-only

# Use a private /tmp that is not shared with other services
PrivateTmp=true

# Whitelist only paths the service needs to write to:
#   - telemetry_buffer.db (offline telemetry cache)
#   - archive/ (rotated telemetry archives)
#   - .keys/ (device provisioning secrets)
ReadWritePaths=/home/obdpi/obd-cortex/telemetry_buffer.db /home/obdpi/obd-cortex/archive /home/obdpi/obd-cortex/.keys

# Drop all Linux capabilities except network access
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Watchdog: if the process hangs for 120s, systemd will restart it
WatchdogSec=120

[Install]
WantedBy=multi-user.target

